# SiteCraft Local Development Environment
NEXTAUTH_URL="http://localhost:3001"
NEXTAUTH_SECRET="sitecraft-development-secret-key-2024-very-long-and-secure"

# OAuth providers (optional - app works without these)
# GOOGLE_CLIENT_ID="your-google-client-id"
# GOOGLE_CLIENT_SECRET="your-google-client-secret"
# GITHUB_ID="your-github-client-id"  
# GITHUB_SECRET="your-github-client-secret"

# Database (optional - app works without database for frontend testing)
# DATABASE_URL="postgresql://username:password@localhost:5432/sitecraft"