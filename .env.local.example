# Copy this file to .env.local and fill in your values

# Database (Required for full functionality)
DATABASE_URL="postgresql://username:password@localhost:5432/sitecraft"

# NextAuth (Required)
NEXTAUTH_URL="http://localhost:3001"
NEXTAUTH_SECRET="your-secret-key-here-make-it-long-and-random"

# Google OAuth (Optional - for Google sign-in)
# Get these from: https://console.developers.google.com/
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# GitHub OAuth (Optional - for GitHub sign-in)  
# Get these from: https://github.com/settings/applications/new
GITHUB_ID="your-github-client-id"
GITHUB_SECRET="your-github-client-secret"

# Note: The app will work without OAuth credentials, but sign-in will be limited to email/password